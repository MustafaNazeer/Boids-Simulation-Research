# Public repo allowlist: ignore everything by default, then permit only the
# files meant to be published (non test source code and the presentations).

# Ignore everything at the root.
/*

# Permit these root entries.
!/.gitignore
!/README.md
!/meetings/

# Inside meetings/: ignore all, then reopen each month directory and its
# placeholder (months are created ahead of their first meeting).
/meetings/*
!/meetings/*/
/meetings/*/*
!/meetings/*/.gitkeep
!/meetings/*/*/

# Inside each meeting (meetings/<month>/<day>/): ignore all, then reopen
# sim/, presentation/, and ml/.
/meetings/*/*/*
!/meetings/*/*/sim/
!/meetings/*/*/presentation/
!/meetings/*/*/ml/

# Inside sim/: ignore all, then permit the package marker, the configuration
# file (added July 2026, the entry points read it at startup), and the boids
# package.
/meetings/*/*/sim/*
!/meetings/*/*/sim/__init__.py
!/meetings/*/*/sim/config.yaml
!/meetings/*/*/sim/foraging.yaml
!/meetings/*/*/sim/boids/

# Inside boids/: ignore all, then permit only Python files.
/meetings/*/*/sim/boids/*
!/meetings/*/*/sim/boids/*.py

# presentation/: permit only the compiled progress deck, nothing else
# (no build_deck.py, no markdown draft, no run-live-demo notes).
/meetings/*/*/presentation/*
!/meetings/*/*/presentation/progress-deck.pptx

# ml/ (added August 2026 for the GRU plus GNN edge classification work):
# ignore all, then permit only Python sources, in the package root and in the
# data/ and models/ subpackages. The test suite, requirements.txt, the results
# write up, the virtualenv, and the generated run data all stay ignored.
/meetings/*/*/ml/*
!/meetings/*/*/ml/*.py
!/meetings/*/*/ml/data/
!/meetings/*/*/ml/models/
/meetings/*/*/ml/data/*
!/meetings/*/*/ml/data/*.py
/meetings/*/*/ml/models/*
!/meetings/*/*/ml/models/*.py

# Never publish Python caches.
__pycache__/
*.pyc
